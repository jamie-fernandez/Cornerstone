{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        ":dependencyDashboard",
        ":semanticCommits"
    ],
    "labels": ["dependencies"],
    "lockFileMaintenance": { "enabled": true },
    "packageRules": [
        {
            "matchManagers": ["pre-commit"],
            "addLabels": ["pre-commit"]
        }
    ]
}

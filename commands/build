#!/bin/bash

# Get the directory of the script
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
PROJECT_ROOT="$(cd "$DIR/.." && pwd)"

cd "$PROJECT_ROOT"

# Function to find an executable
find_executable() {
    local cmd=$1
    local default_path=$2
    if command -v "$cmd" >/dev/null 2>&1; then
        echo "$cmd"
    elif [ -f "$default_path" ]; then
        echo "$default_path"
    else
        echo "$cmd"
    fi
}

BUN_CMD=$(find_executable "bun" "$HOME/.bun/bin/bun")
UV_CMD=$(find_executable "uv" "$HOME/.local/bin/uv")

echo "Building production assets..."

# Build frontend
echo "Building frontend..."
$BUN_CMD run vite build

# Build backend (PyInstaller)
echo "Building backend executable..."
$UV_CMD run commands/build-pyinstaller.py

echo "Build complete! Check the 'dist' directory."

#!/bin/bash

# Get the directory of the script
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
PROJECT_ROOT="$(cd "$DIR/.." && pwd)"

cd "$PROJECT_ROOT"

# Function to kill background processes on exit
cleanup() {
    echo "Shutting down development servers..."
    kill $(jobs -p) 2>/dev/null
    exit
}

trap cleanup SIGINT SIGTERM

# Function to find an executable
find_executable() {
    local cmd=$1
    local default_path=$2
    if command -v "$cmd" >/dev/null 2>&1; then
        echo "$cmd"
    elif [ -f "$default_path" ]; then
        echo "$default_path"
    else
        echo "$cmd" # Fallback to command name and hope for the best
    fi
}

BUN_CMD=$(find_executable "bun" "$HOME/.bun/bin/bun")
UV_CMD=$(find_executable "uv" "$HOME/.local/bin/uv")

echo "Starting development environment..."

# Start the frontend (Vite)
$BUN_CMD run dev &

# Start the backend (Python/pywebview)
$UV_CMD run start.py &

# Wait for all background processes
wait
